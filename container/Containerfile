# Docker Containerfile
FROM docker.io/vllm/vllm-openai:v0.20.2 
# image qui peut servir vLLM avec support OpenAI directement, avec le modèle open weight de mon choix.
# available images at : https://hub.docker.com/r/vllm/vllm-openai/tags
# Métadonnées
LABEL maintainer="Julien P. <PhenixForge>"
LABEL description="vLLM serving Mistral 7B AWQ Marlin- production-grade base optimized image"
LABEL org.opencontainers.image.source="https://github.com/PhenixForge/vllm-serving-kubernetes-platform"

# Args configurables au build
ARG MODEL_NAME=TheBloke/Mistral-7B-Instruct-v0.1-AWQ
ARG MAX_MODEL_LEN=2048
ARG GPU_MEMORY_UTILIZATION=0.6  # <-- limite l'utilisation de la RAM du GPU à 60% max, car ma workstation fait tourner d'autres choses.

ENV MODEL_NAME=${MODEL_NAME}
ENV MAX_MODEL_LEN=${MAX_MODEL_LEN}
ENV PYTHONUNBUFFERED=1

# Healthcheck natif
#HEALTHCHECK --interval=30s --timeout=10s --start-period=5m --retries=3 \
#  CMD curl -f http://localhost:8000/health || exit 1
# Podman error, that works with docker : HEALTHCHECK is not supported for OCI image format and will be ignored.

# Commande par défaut : on passe les args directement à vllm serve
# NOTE : forme exec (tableau JSON) -> pas de substitution des ARG/ENV ci-dessus.
# Les valeurs sont donc figées en dur ici ; pour changer de modèle/contexte/mémoire,
# éditer cette ligne directement (les --build-arg MODEL_NAME/MAX_MODEL_LEN n'ont aucun effet).
CMD ["TheBloke/Mistral-7B-Instruct-v0.1-AWQ", "--quantization", "awq_marlin", "--max-model-len", "880", "--gpu-memory-utilization", "0.6", "--trust-request-chat-template"]

# --quantization=awq_marlin : quantification AWQ (4 bits) optimisée Marlin (+20-30% perf vs awq), réduit la taille du modèle en mémoire (Mistral-7B AWQ ≈ 4 Go).
# --max-model-len 880 : limite la taille du contexte à 880 tokens (réduit depuis 2048/1024 pour tenir dans le KV cache disponible sur 8 Go de VRAM).